# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: used by scripts / server actions that need to bypass RLS (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# App branding / locale defaults
NEXT_PUBLIC_APP_NAME="Solar OS"
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
